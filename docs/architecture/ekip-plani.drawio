<mxfile host="agile-team"><diagram name="Ekip Planı" id="plan"><mxGraphModel dx="1500" dy="1300" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1290"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;Agile Ekip Planı&lt;/b&gt; · Baş Mimar liderliğinde özel Claude ekibi" style="text;html=1;fontSize=26;fontColor=#1f3a5f;align=left;verticalAlign=middle;"><mxGeometry x="40" y="24" width="1200" height="44" as="geometry" /></mxCell><mxCell id="s1" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;1 · Ne yapacağız?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Yalnızca senin bilgisayarında çalışan özel bir Claude eklentisi: &lt;b&gt;agile-team&lt;/b&gt;. Spring Boot ve OpenShift üzerinde Kafka projelerinde işi mimariden teste kadar yürüten, kararı sana bırakan bir ekip." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="84" width="1420" height="92" as="geometry" /></mxCell><mxCell id="s2" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;2 · Kim ne yapacak?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="192" width="1420" height="392" as="geometry" /></mxCell><mxCell id="you" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Sen&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Hedefi verirsin, kararı onaylarsın" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="610" y="214" width="280" height="56" as="geometry" /></mxCell><mxCell id="lead" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Baş Mimar · ana oturum · Opus · /mimar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ekibi yönetir, talimat verir. TOGAF, UML, ArchiMate, CRM ve AI mimarisi.&lt;br&gt;Seçenekleri karşılaştırır, ADR yazar, draw.io çizimlerini yerelde üretir." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2f6f5e;strokeColor=#2f6f5e;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="430" y="304" width="640" height="100" as="geometry" /></mxCell><mxCell id="mgr" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Solution Manager&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Şimdilik pasif, kenarda duruyor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9a9a9a;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;dashed=1;"><mxGeometry x="1180" y="304" width="240" height="100" as="geometry" /></mxCell><mxCell id="designer" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Solution Designer · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;API sözleşmeleri, Kafka olay şemaları, veri modeli, kabul ölçütleri" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="kafka" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kafka Uzmanı · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Partition, sıralama, retry, dead-letter, Strimzi. &lt;b&gt;Yalnızca okur&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="336" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="java" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Java Developer · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Spring Boot kodu. &lt;b&gt;Kodu yalnızca o değiştirir&lt;/b&gt;, tek seferde bir tane" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#b9831f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="612" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="qa" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;QA Tester · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Kabul ölçütlerini test eder. Yalnızca test kodu yazar, gerçek sonucu bildirir" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="888" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="ops" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Operasyon · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;OpenShift, probe, kaynak, geri alma, runbook. &lt;b&gt;Canlıya dokunmaz&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1164" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="s3" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;3 · Nasıl çalışacak?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="600" width="1420" height="232" as="geometry" /></mxCell><mxCell id="st1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;İş kaydı&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Hedef ve kabul ölçütleri bir dosyada" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Mimari&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Seçenekler, ADR, draw.io" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="233" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Senin onayın&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Onaysız kod yazılmaz" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde3dc;strokeColor=#b5482f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="406" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Tasarım&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sözleşme ve şemalar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="579" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st5" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kafka incelemesi&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Kafka'ya dokunuyorsa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="752" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st6" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kod&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Derleme ve test betiği" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="925" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st7" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Test&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Her ölçüte bir test" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1098" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st8" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Canlı hazırlığı&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Canlıya çıkacaksa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1271" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="rule1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Küçük hatada kısa yol&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Yalnızca Java Developer ve QA Tester çalışır. Hata çıkarsa iş kanıtıyla bir önceki role döner; aynı hata iki kez dönerse Mimar sana sorar." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="752" width="680" height="64" as="geometry" /></mxCell><mxCell id="rule2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Bitti tanımı&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Her ölçüte geçen bir test, gerçek test çıktısı, Kafka onayı, geri alma planı, güncel ADR ve çizim, yazılı riskler. Commit ve dağıtım yalnızca sen istersen." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="760" y="752" width="680" height="64" as="geometry" /></mxCell><mxCell id="s4" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;4 · Ne kullanacağız?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="848" width="1420" height="256" as="geometry" /></mxCell><mxCell id="c1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Hazır ve kurulu&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• agile-team: 6 rol, /mimar&lt;br&gt;• Yerel draw.io bilgisi&lt;br&gt;• İş kaydı ve bitti tanımı&lt;br&gt;• Engineering skill'leri&lt;br&gt;• Token harcamayan betikler: derleme-test, çizim kontrolü" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Yarın, senin onayınla kurulacak&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Product Management (Anthropic): gereksinim, sprint&lt;br&gt;• Design (Anthropic): arayüz varsa&lt;br&gt;• Java Backend Skills: Spring&lt;br&gt;• system-design-skills: Kafka, dayanıklılık&lt;br&gt;• draw.io Desktop: otomatik yerleşim ve PDF" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="408" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Sonra, yalnızca okuma izniyle&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• OpenShift için Kubernetes MCP&lt;br&gt;• Kafka MCP&lt;br&gt;• Jira ve Confluence (Atlassian)&lt;br&gt;&lt;br&gt;Gerçek kümeye bağlandığı için önce şirket kuralları kontrol edilecek." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#b9831f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="756" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Bilerek kullanmıyoruz&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• draw.io'nun uzak sunucusu: çizimler dışarı çıkmasın&lt;br&gt;• BMAD: ağır; yalnızca iş kaydı fikrini aldık&lt;br&gt;• 60 ajanlı hazır paketler: pahalı ve dağınık&lt;br&gt;• ArcKit: TOGAF için fikir kaynağı" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9a9a9a;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="1104" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="s5" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;5 · Yarın nereden devam edeceğiz?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="1120" width="1420" height="128" as="geometry" /></mxCell><mxCell id="t1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Proje&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Java projesinin klasörünü göster" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kurulum&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Önerilen eklentileri onayla, draw.io Desktop'ı kur" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="340" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Deneme&lt;/b&gt;&lt;/font&gt;&lt;br&gt;/mimar ile küçük gerçek bir iş çalıştır" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="620" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Karar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Kafka ve OpenShift'e bağlanalım mı?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="900" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t5" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Eksik rol&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Güvenlik rolü gerekiyor mu?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="1180" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="e0" parent="1" edge="1" source="lead" target="designer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="lead" target="kafka" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="lead" target="java" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="lead" target="qa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="lead" target="ops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="you" target="lead" value="onay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="st1" target="st2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" parent="1" edge="1" source="st2" target="st3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" parent="1" edge="1" source="st3" target="st4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" parent="1" edge="1" source="st4" target="st5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" parent="1" edge="1" source="st5" target="st6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" parent="1" edge="1" source="st6" target="st7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" parent="1" edge="1" source="st7" target="st8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry r