<mxfile host="agile-team"><diagram name="Ekip Planı" id="plan"><mxGraphModel dx="1500" dy="1300" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1290"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;Mimari Ekip&lt;/b&gt; · Baş Mimar'ın özel Claude ekibi" style="text;html=1;fontSize=26;fontColor=#1f3a5f;align=left;verticalAlign=middle;"><mxGeometry x="40" y="24" width="1200" height="44" as="geometry" /></mxCell><mxCell id="s1" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;1 · Ne yapacağız?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Baş Mimar'ın özel ekibi. Kod yazmaz; HLD'den sonra &lt;b&gt;herkesle grooming&lt;/b&gt; yapar, herkes LLD'nin kendi bölümünü yazar; &lt;b&gt;neyi, nasıl ve ne ile&lt;/b&gt; yapacağımızı netleştirir, HLD, LLD, ADR ve draw.io çizimlerini üretir. Ortam: Spring Boot ve OpenShift üzerinde Kafka. Yalnızca senin bilgisayarında çalışır." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="84" width="1420" height="92" as="geometry" /></mxCell><mxCell id="s2" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;2 · Kim ne yapacak?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="192" width="1420" height="392" as="geometry" /></mxCell><mxCell id="you" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Sen&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Konuyu verirsin, yönü onaylarsın" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="610" y="214" width="280" height="56" as="geometry" /></mxCell><mxCell id="lead" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Baş Mimar · ana oturum · Opus · /mimar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Kurulu yönetir. TOGAF, UML, ArchiMate, CRM ve AI mimarisi.&lt;br&gt;Seçenekleri karşılaştırır, HLD ve ADR yazar, üst düzey çizimleri üretir." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2f6f5e;strokeColor=#2f6f5e;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="430" y="304" width="640" height="100" as="geometry" /></mxCell><mxCell id="mgr" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Solution Manager&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Şimdilik pasif, kenarda duruyor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9a9a9a;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;dashed=1;"><mxGeometry x="1180" y="304" width="240" height="100" as="geometry" /></mxCell><mxCell id="designer" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Solution Designer · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grooming görüşü. &lt;b&gt;LLD:&lt;/b&gt; API, veri modeli, akışlar, güvenlik. &lt;b&gt;Belgenin editörü&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#b9831f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="java" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Java Uzmanı · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grooming görüşü, çaba. &lt;b&gt;LLD:&lt;/b&gt; servis yapısı, yapılandırma, uygulama adımları" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="336" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="kafka" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kafka Uzmanı · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grooming görüşü. &lt;b&gt;LLD:&lt;/b&gt; topic ve olay şemaları, hata ve yeniden deneme" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="612" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="qa" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Test Uzmanı · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grooming görüşü. &lt;b&gt;LLD:&lt;/b&gt; test yaklaşımı, kabul ve performans doğrulama" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="888" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="ops" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;OpenShift Uzmanı · Sonnet&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Grooming görüşü. &lt;b&gt;LLD:&lt;/b&gt; OpenShift kaynakları, gözlemlenebilirlik" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1164" y="456" width="256" height="112" as="geometry" /></mxCell><mxCell id="s3" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;3 · Nasıl çalışacak?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="600" width="1420" height="232" as="geometry" /></mxCell><mxCell id="st1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Netleştirme&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Hedef, kapsam, kısıt, açık sorular" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Neyi, nasıl, ne ile&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Karar matrisi, ADR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="233" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Senin onayın&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Onaysız HLD yazılmaz" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde3dc;strokeColor=#b5482f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="406" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;HLD ve çizimler&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Baş Mimar yazar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="579" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st5" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Grooming&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Herkes görüşünü söyler, Mimar karara bağlar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde3dc;strokeColor=#b5482f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="752" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st6" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;LLD bölümleri&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Herkes kendi bölümünü yazar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="925" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st7" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Birleştirme, çapraz okuma&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Betik birleştirir, uzmanlar okur" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1098" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="st8" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Betik kontrolü&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Şablon, bağlantı, çizim: 0 token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;spacing=10;"><mxGeometry x="1271" y="644" width="155" height="92" as="geometry" /></mxCell><mxCell id="rule1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Çıktılar · docs/architecture/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Karar matrisi, ADR, HLD, grooming kaydı, uzman bölümlerinden birleşen LLD ve .drawio çizimleri. Çelişkiler gizlenmez, iki taraf ve karar yazılır." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="752" width="680" height="64" as="geometry" /></mxCell><mxCell id="rule2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Bitti tanımı&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Üç soru cevaplı, herkes groominge katıldı, 14 LLD bölümü sahibince yazıldı, çapraz okundu, her önemli karara ADR, çizim bağlantıları çalışıyor." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="760" y="752" width="680" height="64" as="geometry" /></mxCell><mxCell id="s4" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;4 · Ne kullanacağız?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="848" width="1420" height="256" as="geometry" /></mxCell><mxCell id="c1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Hazır ve kurulu&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• agile-team: 6 rol, /mimar&lt;br&gt;• HLD, LLD, ADR, karar matrisi şablonları&lt;br&gt;• Bölümleri birleştiren betik&lt;br&gt;• Yerel draw.io bilgisi&lt;br&gt;• Engineering skill'leri&lt;br&gt;• Token harcamayan belge ve çizim kontrolü" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f1ec;strokeColor=#2f6f5e;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Yarın, senin onayınla kurulacak&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• draw.io Desktop: otomatik yerleşim ve PDF&lt;br&gt;• Product Management (Anthropic): gereksinim&lt;br&gt;• system-design-skills: Kafka, dayanıklılık&lt;br&gt;• Java Backend Skills: Spring görüşleri için" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="408" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Sonra, karar verirsen&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Confluence ve Jira (Atlassian): belge yayımlama&lt;br&gt;• Kubernetes ve Kafka MCP: mevcut durumu yalnızca okumak için&lt;br&gt;&lt;br&gt;Gerçek sistemlere bağlandığı için önce şirket kuralları kontrol edilecek." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#b9831f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="756" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Bilerek kullanmıyoruz&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• draw.io'nun uzak sunucusu: çizimler dışarı çıkmasın&lt;br&gt;• Kod yazan ajanlar: ekibin işi değil&lt;br&gt;• BMAD ve 60 ajanlı paketler: ağır&lt;br&gt;• ArcKit: TOGAF için fikir kaynağı" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9a9a9a;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="1104" y="892" width="335" height="196" as="geometry" /></mxCell><mxCell id="s5" parent="1" vertex="1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;5 · Yarın nereden devam edeceğiz?&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f6f2;strokeColor=#d8d4c8;fontColor=#222222;fontSize=13;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="40" y="1120" width="1420" height="128" as="geometry" /></mxCell><mxCell id="t1" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Konu&lt;/b&gt;&lt;/font&gt;&lt;br&gt;İlk mimari konuyu ver" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="60" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t2" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Şablon&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Kurumun HLD/LLD şablonu varsa uyarlayalım" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="340" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t3" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Kurulum&lt;/b&gt;&lt;/font&gt;&lt;br&gt;draw.io Desktop ve önerilen eklentiler" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="620" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t4" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Deneme&lt;/b&gt;&lt;/font&gt;&lt;br&gt;/mimar ile ilk karar matrisi ve HLD" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="900" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="t5" parent="1" vertex="1" value="&lt;font style='font-size:15px'&gt;&lt;b&gt;Karar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Belgeler Confluence'a gitsin mi?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eef6;strokeColor=#1f3a5f;fontColor=#222222;fontSize=13;align=left;verticalAlign=middle;spacing=10;"><mxGeometry x="1180" y="1164" width="268" height="68" as="geometry" /></mxCell><mxCell id="e0" parent="1" edge="1" source="lead" target="designer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="lead" target="java" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="lead" target="kafka" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="lead" target="qa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="lead" target="ops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="you" target="lead" value="onay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="st1" target="st2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" parent="1" edge="1" source="st2" target="st3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" parent="1" edge="1" source="st3" target="st4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" parent="1" edge="1" source="st4" target="st5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" parent="1" edge="1" source="st5" target="st6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" parent="1" edge="1" source="st6" target="st7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;"><mxGe